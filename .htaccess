# Kindlewood frontend — browser caching and compression for the cPanel host.
#
# Why: the uploaded site is built by scripts/build.js (npm run build): a few
# bundles whose names carry a hash of their contents, so browsers can keep
# them for a year and a change always arrives under a new name. index.html is
# never cached, so a new upload is picked up straight away.
#
# If the host already has a .htaccess here (e.g. an HTTPS redirect), paste
# these rules into it instead of replacing it.

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|gif|svg|ico|mp3|wav|ogg|woff2?|ttf|json)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/webp "access plus 7 days"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType audio/mpeg "access plus 7 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
